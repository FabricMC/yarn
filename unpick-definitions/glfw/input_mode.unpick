unpick v3

group int input_mode
	net.minecraft.client.util.InputUtil.GLFW_CURSOR

group int value
	net.minecraft.client.util.InputUtil.GLFW_CURSOR_DISABLED
	net.minecraft.client.util.InputUtil.GLFW_CURSOR_NORMAL

target_method org.lwjgl.glfw.GLFW glfwSetInputMode (JII)V
	param 1 input_mode
	param 2 value
